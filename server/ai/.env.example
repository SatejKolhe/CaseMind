# AI Provider Configuration (CaseMind Member 2)
# Supported AI_PROVIDER values: gemini | openai
AI_PROVIDER=gemini

# Provider API Key (never commit real credentials)
AI_API_KEY=your_gemini_or_openai_api_key_here

# Model name:
# For Gemini: gemini-3.5-flash-lite (fastest, recommended), gemini-3.5-flash
# For OpenAI: gpt-4o, gpt-4o-mini
AI_MODEL=gemini-3.5-flash-lite

# Timeout per HTTP attempt in milliseconds (default: 60000)
AI_TIMEOUT_MS=60000

# Maximum retry attempts on 429 rate limit or 5xx server errors (default: 2)
AI_MAX_RETRIES=2

# Maximum token budget for injected evidence context (default: 6000)
CONTEXT_TOKEN_BUDGET=6000

# Whether to use LLM-based redaction vs rule-based regex redaction (default: false)
USE_LLM_REDACTION=false
